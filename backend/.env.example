# Copy to `.env` and fill in. Never commit the real `.env`.

DATABASE_URL=sqlite:///./zoom_clone.db

# Origins allowed to call the API (comma-separated) and the public frontend URL
# used to build invite links.
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Default "logged-in" user (authentication is out of scope for this assignment).
DEFAULT_USER_NAME=Vansh Sharma
DEFAULT_USER_EMAIL=vansh.sharma@example.com
SEED_SAMPLE_DATA=true

# LiveKit Cloud (free tier): https://cloud.livekit.io -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=180
